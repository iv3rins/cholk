# Port the proxy listens on.
PORT=8787

# The real DeepSeek API key. Never expose this to clients.
DEEPSEEK_API_KEY=sk-replace-me

# Token that clients send instead of the real key. Leave empty only for
# local development on a trusted machine.
PROXY_TOKEN=replace-with-a-long-random-string

# Upstream API. Change only when using a compatible gateway.
DEEPSEEK_API_ORIGIN=https://api.deepseek.com

# Maximum request body size in MiB. DeepSeek Files API accepts files up to 64 MiB.
MAX_BODY_MB=80

# Comma-separated web origins, or * for any origin. Same-origin deployments do
# not need CORS at all, but * is convenient during local development.
ALLOWED_ORIGINS=*
