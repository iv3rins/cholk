# Required. The fixed upstream origin must include the /v1 path.
OPENAI_API_KEY=replace-with-the-upstream-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Deployment binds to loopback by default; terminate TLS before public exposure.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/accounts.db

# Registration is closed unless explicitly enabled.
ALLOW_REGISTRATION=false

# Comma-separated exact browser origins; empty disables CORS.
CORS_ORIGINS=

TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576
